@model SpecToCode1.Model.ViewModels.EducationViewModel

@{
    ViewData["Title"] = "Edit Education";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@ViewData["Title"]</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="EducationType" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="EducationType" class="form-control" placeholder="e.g. High School, Bachelor's" />
                                <span asp-validation-for="EducationType" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="InstitutionName" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="InstitutionName" class="form-control" placeholder="Enter Institution Name" />
                                <span asp-validation-for="InstitutionName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="AddressLine1" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="AddressLine1" class="form-control" placeholder="Address Line 1" />
                                <span asp-validation-for="AddressLine1" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="AddressLine2" class="form-label fw-bold"></label>
                                <input asp-for="AddressLine2" class="form-control" placeholder="Address Line 2 (Optional)" />
                                <span asp-validation-for="AddressLine2" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="City" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="City" class="form-control" placeholder="City" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="State" class="form-label fw-bold"></label>
                                <input asp-for="State" class="form-control" placeholder="State" />
                                <span asp-validation-for="State" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Pincode" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="Pincode" class="form-control" placeholder="Pincode" />
                                <span asp-validation-for="Pincode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Update Education</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}